{
  "name": "apartment-booking",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @apartment/web --filter @apartment/api dev",
    "build": "pnpm --recursive build",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --recursive test",
    "test:e2e": "pnpm --filter @apartment/web test:e2e",
    "db:migrate": "pnpm --filter @apartment/api db:migrate",
    "db:migrate:undo": "pnpm --filter @apartment/api db:migrate:undo",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.3"
  }
}
