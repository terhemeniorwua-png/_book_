# Public URL used by browser requests. It must be reachable from the guest browser.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
# Server-side URL used by Next.js rendering. A private API network address is
# allowed here; client bundles use NEXT_PUBLIC_API_BASE_URL instead.
API_BASE_URL=http://localhost:4000/api/v1
# Canonical public web origin for metadata and production links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Next.js dev/start listen port. Hosting platforms normally inject PORT.
PORT=3000
