{
  "name": "@apartment/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:migrate": "tsx src/db/migrate.ts up",
    "db:migrate:undo": "tsx src/db/migrate.ts down",
    "db:migrate:test": "NODE_ENV=test tsx src/db/migrate.ts up",
    "db:migrate:test:undo": "NODE_ENV=test tsx src/db/migrate.ts down",
    "db:test": "RUN_DB_INTEGRATION_TESTS=true vitest run src/db/database.test.ts",
    "db:seed:apartments": "tsx src/db/seeders/run-apartment-seeder.ts up",
    "db:seed:apartments:undo": "tsx src/db/seeders/run-apartment-seeder.ts down",
    "db:provision-admin": "tsx src/db/provision-admin.ts"
    ,"payments:reconcile": "tsx src/db/reconcile-payments.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.922.0",
    "@aws-sdk/s3-request-presigner": "3.922.0",
    "argon2": "0.45.1",
    "cors": "2.8.5",
    "dotenv": "16.6.1",
    "express": "5.1.0",
    "express-rate-limit": "8.7.2",
    "helmet": "8.1.0",
    "joi": "18.0.1",
    "libphonenumber-js": "1.13.15",
    "pg": "8.16.3",
    "pg-hstore": "2.3.4",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "rate-limit-redis": "6.0.2",
    "redis": "6.3.1",
    "sequelize": "6.37.7",
    "umzug": "3.8.2",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.5",
    "@types/node": "22.19.1",
    "@types/pg": "8.15.6",
    "@types/supertest": "6.0.3",
    "eslint": "9.39.1",
    "supertest": "7.1.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
