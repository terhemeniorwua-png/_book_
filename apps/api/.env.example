NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/apartment_booking
# Required only for the explicitly enabled PostgreSQL integration tests and test migrations.
# Use a dedicated database that contains no non-test data.
# TEST_DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/apartment_booking_test
DB_SSL=false
# For managed TLS databases, set DB_SSL=true and provide the provider CA PEM
# through DB_SSL_CA so certificates remain verified.
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
DB_POOL_MAX=10
# Optional for coordinated rate limits across multiple API instances.
# If set, API startup requires a reachable Redis service.
# REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
# Only set to a known proxy hop count for the deployment network.
TRUST_PROXY_HOPS=0
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
RATE_LIMIT_SENSITIVE_MAX=10
RATE_LIMIT_APARTMENT_MAX=120
BOOKING_TIME_ZONE=Africa/Lagos
# Paystack REST integration. Obtain matching test keys from the Paystack dashboard
# Developers > API Keys. Use sk_test_... / pk_test_... outside production and
# sk_live_... / pk_live_... only in production. The secret key is backend-only.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CURRENCY=NGN
# Browser return route; Paystack appends the transaction reference. The booking
# reference is added per transaction. Production must use your HTTPS web domain.
PAYSTACK_CALLBACK_URL=https://your-domain.com/booking/payment/callback
# POST webhook endpoint; configure the exact HTTPS URL in the Paystack dashboard.
PAYSTACK_WEBHOOK_URL=https://api.your-domain.com/api/v1/payments/paystack/webhook
# Transactions older than this are checked against Paystack by the reconciliation command.
PAYMENT_RECONCILIATION_AGE_MINUTES=30
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=apartment-images
S3_ACCESS_KEY_ID=replace_me
S3_SECRET_ACCESS_KEY=replace_me
